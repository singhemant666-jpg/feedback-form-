{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/feedback",
        "destination": "/feedback/index.html"
      },
      {
        "source": "/referral",
        "destination": "/referral/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
